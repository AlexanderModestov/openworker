# Copy to docker/.env and fill in what you need, then:
#   docker run --env-file docker/.env -p 8765:8765 -p 1420:1420 \
#     -v openworker-data:/data -v "$PWD:/workspace" openworker

# Pick one model provider key (see coworker/providers/registry.py for the full list):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Telegram connector — token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to message the bot. Empty = nobody.
TELEGRAM_ALLOWED_USERS=
