# Copy to docker/.env and fill in what you need, then:
#   docker run --env-file docker/.env -p 8765:8765 -p 1420:1420 \
#     -v openworker-data:/data -v "$PWD:/workspace" openworker

# Set the key(s) for whichever provider(s) you use — unset ones are simply unavailable
# as a model choice (see coworker/providers/registry.py for the full list/env var names).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible vendors — same resolution (explicit profile key wins, else this env var).
ARK_API_KEY=
ARK_AGENT_PLAN_CN_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
META_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=

# Telegram connector — token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to message the bot. Empty = nobody.
TELEGRAM_ALLOWED_USERS=
